{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pmart.local/events/WaveStateChanged.v1.json",
  "title": "WaveStateChanged",
  "description": "Wave 상태가 전이된 사실. 발행 cdc-outbound. 구독 backoffice-bff. 토픽 cdc.outbound.v1",
  "allOf": [
    {
      "$ref": "_envelope.v1.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "WaveStateChanged"
        },
        "aggregateType": {
          "const": "Wave"
        },
        "payload": {
          "type": "object",
          "required": [
            "waveId",
            "state"
          ],
          "properties": {
            "waveId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "cdcId": {
              "$ref": "_defs.v1.json#/$defs/CenterId"
            },
            "state": {
              "type": "string"
            },
            "previousState": {
              "type": "string"
            },
            "trfIds": {
              "type": "array",
              "items": {
                "$ref": "_defs.v1.json#/$defs/Ref"
              }
            },
            "changedAt": {
              "$ref": "_defs.v1.json#/$defs/DateTime"
            }
          },
          "additionalProperties": true
        }
      }
    }
  ]
}
