{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pmart.local/events/RiderAuthenticated.v1.json",
  "title": "RiderAuthenticated",
  "description": "라이더 소셜 로그인 성공(2026-11-25 — 고객 CustomerAuthenticated 와 같게). 발행 rider-auth. 구독 rider. 토픽 platform.auth.v1. 소셜 이름·닉네임만(사진·이메일 원문 없음). 개인정보 — 로그 금지",
  "allOf": [
    {
      "$ref": "_envelope.v1.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "RiderAuthenticated"
        },
        "aggregateType": {
          "const": "RiderAccount"
        },
        "payload": {
          "type": "object",
          "required": [
            "riderId",
            "provider",
            "authenticatedAt"
          ],
          "properties": {
            "riderId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "provider": {
              "type": "string",
              "enum": [
                "GOOGLE",
                "KAKAO",
                "NAVER"
              ],
              "description": "소셜 제공자"
            },
            "authenticatedAt": {
              "$ref": "_defs.v1.json#/$defs/DateTime"
            },
            "name": {
              "type": "string",
              "maxLength": 100,
              "description": "제공자 실명(구글 name·네이버 response.name). 카카오는 실명을 주지 않아 없음"
            },
            "providerNickname": {
              "type": "string",
              "maxLength": 100,
              "description": "제공자 닉네임(카카오 닉네임·네이버 별명), 없으면 이름(구글은 이름)"
            }
          },
          "additionalProperties": true
        }
      }
    }
  ]
}
