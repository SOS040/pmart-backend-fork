{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pmart.local/events/MfcLocationStateChanged.v1.json",
  "title": "MfcLocationStateChanged",
  "description": "MFC 위치가 등록되거나 속성·상태가 바뀐 사실(등록 때 previousState 없음). 발행 mfc-location. 구독 mfc-inventory, mfc-fulfillment. 토픽 mfc.location.v1. 위치 전체 속성을 싣는다(투영용, 2026-11-07 필드 추가) — 같은 locationId 는 version 이 큰 것만 반영",
  "allOf": [
    {
      "$ref": "_envelope.v1.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "MfcLocationStateChanged"
        },
        "aggregateType": {
          "const": "Location"
        },
        "payload": {
          "type": "object",
          "required": [
            "locationId",
            "state"
          ],
          "properties": {
            "locationId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "mfcId": {
              "$ref": "_defs.v1.json#/$defs/CenterId"
            },
            "state": {
              "type": "string"
            },
            "previousState": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            },
            "changedAt": {
              "$ref": "_defs.v1.json#/$defs/DateTime"
            },
            "locationCode": {
              "type": "string",
              "maxLength": 32
            },
            "areaCode": {
              "type": [
                "string",
                "null"
              ]
            },
            "zone": {
              "type": "string",
              "enum": [
                "RECEIVING",
                "STORAGE",
                "PICKING",
                "PACKING",
                "QUARANTINE",
                "DISPATCH_STAGING",
                "RETURN",
                "DISPOSAL",
                "CART"
              ]
            },
            "temperatureZone": {
              "type": "string",
              "enum": [
                "AMBIENT",
                "CHILLED",
                "FROZEN"
              ]
            },
            "version": {
              "type": "integer",
              "minimum": 1
            },
            "pickSequence": {
              "type": [
                "integer",
                "null"
              ]
            },
            "highTurnover": {
              "type": "boolean",
              "description": "고회전 선반(같은 상품 여러 칸 허용), 2026-11-08"
            },
            "widthMm": {
              "type": [
                "integer",
                "null"
              ],
              "description": "칸 치수·하중(재고 이동 용량 계산), 2026-11-08"
            },
            "depthMm": {
              "type": [
                "integer",
                "null"
              ],
              "description": "칸 치수·하중(재고 이동 용량 계산), 2026-11-08"
            },
            "heightMm": {
              "type": [
                "integer",
                "null"
              ],
              "description": "칸 치수·하중(재고 이동 용량 계산), 2026-11-08"
            },
            "maxWeightG": {
              "type": [
                "integer",
                "null"
              ],
              "description": "칸 치수·하중(재고 이동 용량 계산), 2026-11-08"
            }
          },
          "additionalProperties": true
        }
      }
    }
  ]
}
