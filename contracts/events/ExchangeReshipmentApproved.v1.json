{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pmart.local/events/ExchangeReshipmentApproved.v1.json",
  "title": "ExchangeReshipmentApproved",
  "description": "교환 승인(재배송은 교환 건만). 발행 claim-service. 구독 order, delivery-dispatch, mfc-fulfillment. 토픽 order.claim.v1. 단계 ②",
  "allOf": [
    {
      "$ref": "_envelope.v1.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "ExchangeReshipmentApproved"
        },
        "aggregateType": {
          "const": "Claim"
        },
        "payload": {
          "type": "object",
          "required": [
            "claimId",
            "orderId",
            "lines",
            "newShipmentRef"
          ],
          "properties": {
            "claimId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "orderId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "lines": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "orderLineId",
                  "qty"
                ],
                "properties": {
                  "orderLineId": {
                    "$ref": "_defs.v1.json#/$defs/Ref"
                  },
                  "qty": {
                    "$ref": "_defs.v1.json#/$defs/PositiveQty"
                  }
                },
                "additionalProperties": true
              },
              "minItems": 1
            },
            "newShipmentRef": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "approvalRef": {
              "$ref": "_defs.v1.json#/$defs/ApprovalRef"
            },
            "approvedAt": {
              "$ref": "_defs.v1.json#/$defs/DateTime"
            }
          },
          "additionalProperties": true
        }
      }
    }
  ]
}
