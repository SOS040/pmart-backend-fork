{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pmart.local/events/ReplenishmentMoveCreated.v1.json",
  "title": "ReplenishmentMoveCreated",
  "description": "최소 수량 이하 LOC의 자동 보충 이동(MOV)이 생성된 사실(센터 내부 이동, TRF 아님). 발행 cdc-inbound. 구독 cdc-location, backoffice-bff. 토픽 cdc.inbound.v1",
  "allOf": [
    {
      "$ref": "_envelope.v1.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "ReplenishmentMoveCreated"
        },
        "aggregateType": {
          "const": "Move"
        },
        "payload": {
          "type": "object",
          "required": [
            "movId",
            "fromLoc",
            "toLoc",
            "sku",
            "qty"
          ],
          "properties": {
            "movId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "cdcId": {
              "$ref": "_defs.v1.json#/$defs/CenterId"
            },
            "fromLoc": {
              "type": "string"
            },
            "toLoc": {
              "type": "string"
            },
            "sku": {
              "$ref": "_defs.v1.json#/$defs/Sku"
            },
            "lot": {
              "type": "string"
            },
            "lpn": {
              "type": "string"
            },
            "qty": {
              "$ref": "_defs.v1.json#/$defs/PositiveQty"
            },
            "createdAt": {
              "$ref": "_defs.v1.json#/$defs/DateTime"
            }
          },
          "additionalProperties": true
        }
      }
    }
  ]
}
