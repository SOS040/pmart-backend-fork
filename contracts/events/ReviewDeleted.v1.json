{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pmart.local/events/ReviewDeleted.v1.json",
  "title": "ReviewDeleted",
  "description": "리뷰 삭제(삭제 후 재작성 불가). 발행 review-service. 구독 product-content, audit. 토픽 commerce.review.v1. 단계 ②",
  "allOf": [
    {
      "$ref": "_envelope.v1.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "ReviewDeleted"
        },
        "aggregateType": {
          "const": "Review"
        },
        "payload": {
          "type": "object",
          "required": [
            "reviewId",
            "orderLineId",
            "productId"
          ],
          "properties": {
            "reviewId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "orderLineId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "productId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "rating": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "deletedAt": {
              "$ref": "_defs.v1.json#/$defs/DateTime"
            },
            "reason": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      }
    }
  ]
}
