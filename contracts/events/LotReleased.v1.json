{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pmart.local/events/LotReleased.v1.json",
  "title": "LotReleased",
  "description": "quality 해제 요청을 반영하여 LOT 차단을 해제한 사실. 발행 cdc-inventory. 구독 cdc-outbound, replenishment, mfc-quality(리콜 참조), order(영향 참조). 토픽 cdc.inventory.v1",
  "allOf": [
    {
      "$ref": "_envelope.v1.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "LotReleased"
        },
        "aggregateType": {
          "const": "Lot"
        },
        "payload": {
          "type": "object",
          "required": [
            "sku",
            "lot",
            "releasedQty"
          ],
          "properties": {
            "cdcId": {
              "$ref": "_defs.v1.json#/$defs/CenterId"
            },
            "sku": {
              "$ref": "_defs.v1.json#/$defs/Sku"
            },
            "lot": {
              "type": "string"
            },
            "scope": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            },
            "releasedQty": {
              "$ref": "_defs.v1.json#/$defs/Qty"
            },
            "holdReleaseId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "commitId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "releasedAt": {
              "$ref": "_defs.v1.json#/$defs/DateTime"
            }
          },
          "additionalProperties": true
        }
      }
    }
  ]
}
