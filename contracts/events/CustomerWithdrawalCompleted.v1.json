      "properties": {
        "eventType": {
          "const": "CustomerWithdrawalCompleted"
        },
        "aggregateType": {
          "const": "Customer"
        },
        "payload": {
          "type": "object",
          "required": [
            "accountId",
            "completedAt"
          ],
          "properties": {
            "accountId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "completedAt": {
              "$ref": "_defs.v1.json#/$defs/DateTime"
            }
          },
          "additionalProperties": true
        }
      }
    }
  ]
