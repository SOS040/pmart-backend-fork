{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pmart.local/events/ProductVersionPublished.v1.json",
  "title": "ProductVersionPublished",
  "description": "승인된 상품/SKU 버전 발효. 발행 product-service. 구독 product-content, search, storefront, pricing, cdc-inventory, mfc-inventory, order, cart. 토픽 commerce.product.v1. 단계 ①",
  "allOf": [
    {
      "$ref": "_envelope.v1.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "ProductVersionPublished"
        },
        "aggregateType": {
          "const": "Product"
        },
        "payload": {
          "type": "object",
          "required": [
            "productId",
            "baseProductId",
            "skus",
            "version"
          ],
          "properties": {
            "productId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "baseProductId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "skus": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "sku",
                  "unitsPerSku",
                  "weightG"
                ],
                "properties": {
                  "sku": {
                    "$ref": "_defs.v1.json#/$defs/Sku"
                  },
                  "unitsPerSku": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "weightG": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "단위 중량(g)"
                  },
                  "packagingSpec": {
                    "type": "object",
                    "required": [],
                    "properties": {
                      "packagingType": {
                        "type": "string"
                      },
                      "requiresBag": {
                        "type": "boolean"
                      },
                      "fragile": {
                        "type": "boolean"
                      },
                      "temperatureZone": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": true,
                    "description": "포장 규격"
                  },
                  "unitType": {
                    "type": "string",
                    "enum": [
                      "E",
                      "B"
                    ]
                  },
                  "storageType": {
                    "type": "string",
                    "enum": [
                      "AMBIENT",
                      "CHILLED",
                      "FROZEN"
                    ]
                  },
                  "alcohol": {
                    "type": "boolean"
                  },
                  "shelfLifeGuarantee": {
                    "type": "object",
                    "required": [],
                    "properties": {
                      "minRemainingDays": {
                        "type": "integer",
                        "minimum": 0,
                        "description": "주문일 기준 소비기한이 최소 이만큼 남은 상품을 보낸다(상품 고시 '주문일 기준 N일 이상 남은 상품')"
                      },
                      "maxDaysSinceManufacture": {
                        "type": "integer",
                        "minimum": 0,
                        "description": "주문일 기준 제조 후 이 일수 이내인 상품을 보낸다(상품 고시 '주문일 기준 N일 이내 제조된 상품')"
                      }
                    },
                    "additionalProperties": false,
                    "description": "상품별 소비기한 보장(ADR-0041). 없으면 보장 문구가 없는 상품 — 재고는 보관 유형 기본 최소 잔여일을 쓴다"
                  },
                  "volumeMl": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "barcodes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "활성 바코드(선행 0 보존)"
                  },
                  "state": {
                    "type": "string",
                    "enum": [
                      "ACTIVE",
                      "INACTIVE"
                    ]
                  },
                  "logistics": {
                    "type": "object",
                    "properties": {
                      "unitsPerBox": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "boxesPerPallet": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "ti": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "hi": {
                        "type": "integer",
                        "minimum": 1
                      }
                    },
                    "additionalProperties": true
                  }
                },
                "additionalProperties": true
              },
              "minItems": 1
            },
            "categoryPaths": {
              "type": "array",
              "items": {
                "type": "string",
                "description": "categoryId 경로 (루트→리프, / 구분)"
              }
            },
            "version": {
              "$ref": "_defs.v1.json#/$defs/Version"
            }, "rowVersion": {"$ref": "_defs.v1.json#/$defs/Version", "description": "반영 뒤 상품 행 버전(row_version). ProductSaleStateChanged.payload.version 과 같은 카운터 — 소비자는 판매 상태를 시각이 아니라 이 값으로 비교한다(2026-11-04 추가, 없으면 옛 사건)"}, "filterOptions": {"type": "array", "description": "승인 속성(필터 옵션). 검색이 filters 파라미터(그룹 id.옵션)로 거르는 데 쓴다(2026-11-04 추가, 없으면 옛 사건)", "items": {"type": "object", "required": ["filterGroupId", "option"], "properties": {"filterGroupId": {"type": "string"}, "option": {"type": "string"}}}},
            "effectiveAt": {
              "$ref": "_defs.v1.json#/$defs/DateTime"
            },
            "approvalRef": {
              "$ref": "_defs.v1.json#/$defs/ApprovalRef"
            },
            "internalName": {
              "type": "string",
              "description": "관리용 명칭(고객용 명칭은 product-content)"
            },
            "saleState": {
              "type": "string",
              "enum": [
                "ON_SALE",
                "TEMPORARILY_SOLD_OUT",
                "SALE_STOPPED"
              ]
            },
            "primaryCategoryId": {
              "type": "string",
              "description": "대표 카테고리 노드 id (ADR-0015)"
            },
            "categoryIds": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "노출 카테고리 노드 id 전체"
            },
            "sources": {
              "type": "array",
              "description": "외부 원천 키(seed-v1 등). product-content 가 초안을 이 키로 연결",
              "items": {
                "type": "object",
                "required": [
                  "system",
                  "key"
                ],
                "properties": {
                  "system": {
                    "type": "string"
                  },
                  "key": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": true
        }
      }
    }
  ]
}
