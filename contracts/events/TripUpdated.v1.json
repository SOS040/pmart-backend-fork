{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pmart.local/events/TripUpdated.v1.json",
  "title": "TripUpdated",
  "description": "확정된 운행 배정이 변경된 사실(차량·기사·정차·화물). 발행 transport-planning. 구독 cdc-outbound, mfc-inbound, transport-execution, cold-chain, fleet. 토픽 tms.trip.v1",
  "allOf": [
    {
      "$ref": "_envelope.v1.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "TripUpdated"
        },
        "aggregateType": {
          "const": "Trip"
        },
        "payload": {
          "type": "object",
          "required": [
            "tripId",
            "assignmentVersion"
          ],
          "properties": {
            "tripId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "assignmentVersion": {
              "$ref": "_defs.v1.json#/$defs/Version"
            },
            "previousAssignmentVersion": {
              "$ref": "_defs.v1.json#/$defs/Version"
            },
            "vehicleId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "driverId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "fromCdc": {
              "$ref": "_defs.v1.json#/$defs/CenterId"
            },
            "plannedDepartureAt": {
              "$ref": "_defs.v1.json#/$defs/DateTime"
            },
            "stops": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "stopId",
                  "mfcId",
                  "plannedArrival"
                ],
                "properties": {
                  "stopId": {
                    "$ref": "_defs.v1.json#/$defs/Ref"
                  },
                  "mfcId": {
                    "$ref": "_defs.v1.json#/$defs/CenterId"
                  },
                  "sequence": {
                    "type": "integer"
                  },
                  "plannedArrival": {
                    "$ref": "_defs.v1.json#/$defs/DateTime"
                  },
                  "window": {
                    "$ref": "_defs.v1.json#/$defs/TimeWindow"
                  }
                }
              }
            },
            "cargo": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "trfId"
                ],
                "properties": {
                  "trfId": {
                    "$ref": "_defs.v1.json#/$defs/Ref"
                  },
                  "lpns": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "compartment": {
                    "type": "string",
                    "description": "차량 구획"
                  },
                  "tempZone": {
                    "type": "string"
                  }
                }
              }
            },
            "changeReason": {
              "type": "string"
            },
            "updatedAt": {
              "$ref": "_defs.v1.json#/$defs/DateTime"
            }
          },
          "additionalProperties": true
        }
      }
    }
  ]
}
