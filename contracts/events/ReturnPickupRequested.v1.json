{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pmart.local/events/ReturnPickupRequested.v1.json",
  "title": "ReturnPickupRequested",
  "description": "회수 승인. pickupAddressRef는 원주문 주소 참조(원문 없음). 발행 claim-service. 구독 delivery-dispatch. 토픽 order.claim.v1. 단계 ②",
  "allOf": [
    {
      "$ref": "_envelope.v1.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "ReturnPickupRequested"
        },
        "aggregateType": {
          "const": "Claim"
        },
        "payload": {
          "type": "object",
          "required": [
            "claimId",
            "orderId",
            "deliveryId",
            "lines",
            "pickupAddressRef"
          ],
          "properties": {
            "claimId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "orderId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "deliveryId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "mfcId": {
              "$ref": "_defs.v1.json#/$defs/CenterId"
            },
            "lines": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "orderLineId",
                  "qty"
                ],
                "properties": {
                  "orderLineId": {
                    "$ref": "_defs.v1.json#/$defs/Ref"
                  },
                  "qty": {
                    "$ref": "_defs.v1.json#/$defs/PositiveQty"
                  }
                },
                "additionalProperties": true
              },
              "minItems": 1
            },
            "pickupAddressRef": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "requestedAt": {
              "$ref": "_defs.v1.json#/$defs/DateTime"
            }
          },
          "additionalProperties": true
        }
      }
    }
  ]
}
