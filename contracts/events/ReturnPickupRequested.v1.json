{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pmart.local/events/ReturnPickupRequested.v1.json",
  "title": "ReturnPickupRequested",
  "description": "회수 요청(반품 클레임 RETURN — 회수비 결제됨·면제, 또는 회수 실패 뒤 다시 요청). pickupAddressRef는 원주문 주소 참조(원문 없음 — 'order:<orderId>', 회수지 = 원주문 배송지 고정). 발행 claim-service. 구독 delivery-dispatch(고객 반품 회수 배송 type RETURN·purpose CLAIM_RETURN — DD-3, 구독 전). 토픽 order.claim.v1. 단계 ② 2026-11-17(CL-1): 구독자 구현 전이라(delivery-dispatch 아직 — 확인 2026-11-17) deliveryId 를 필수에서 뺐다 — claim 은 원래 배송 ID 를 모른다(dispatch 가 orderId 로 찾는다). pickupRequestId·attempt·purpose·lines[].claimLineId·sku 추가. 같은 클레임의 회수 요청은 attempt 마다 하나(pickupRequestId 유일).",
  "allOf": [
    {
      "$ref": "_envelope.v1.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "ReturnPickupRequested"
        },
        "aggregateType": {
          "const": "Claim"
        },
        "payload": {
          "type": "object",
          "required": [
            "claimId",
            "orderId",
            "lines",
            "pickupAddressRef"
          ],
          "properties": {
            "claimId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "orderId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "deliveryId": {
              "$ref": "_defs.v1.json#/$defs/Ref",
              "description": "원래 배송(알면) — claim 은 싣지 않는다(2026-11-17)"
            },
            "mfcId": {
              "$ref": "_defs.v1.json#/$defs/CenterId",
              "description": "반납할 MFC = 원주문 이행 센터"
            },
            "pickupRequestId": {
              "$ref": "_defs.v1.json#/$defs/Ref",
              "description": "회수 요청 ID '<claimId>-P<attempt>'(2026-11-17) — dispatch 는 이것으로 회수 배송을 하나만 만든다"
            },
            "attempt": {
              "type": "integer",
              "minimum": 1,
              "description": "회수 시도 번호(2026-11-17). 1 = 처음, 2 = 첫 실패 뒤 자동 재요청, 3~ = 상담원 재요청"
            },
            "purpose": {
              "type": "string",
              "enum": [
                "CLAIM_RETURN"
              ],
              "description": "회수 배송 목적(2026-11-17) — DeliveryCreated·ReturnPickedUp 의 purpose 와 같은 값"
            },
            "feeWaived": {
              "type": "boolean",
              "description": "회수비 면제(회사 잘못) 여부(2026-11-17) — 표시용"
            },
            "lines": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "orderLineId",
                  "qty"
                ],
                "properties": {
                  "orderLineId": {
                    "$ref": "_defs.v1.json#/$defs/Ref"
                  },
                  "qty": {
                    "$ref": "_defs.v1.json#/$defs/PositiveQty"
                  },
                  "claimLineId": {
                    "$ref": "_defs.v1.json#/$defs/Ref"
                  },
                  "sku": {
                    "$ref": "_defs.v1.json#/$defs/Sku"
                  }
                },
                "additionalProperties": true
              },
              "minItems": 1
            },
            "pickupAddressRef": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "requestedAt": {
              "$ref": "_defs.v1.json#/$defs/DateTime"
            }
          },
          "additionalProperties": true
        }
      }
    }
  ]
}
