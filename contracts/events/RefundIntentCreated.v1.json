{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pmart.local/events/RefundIntentCreated.v1.json",
  "title": "RefundIntentCreated",
  "description": "환불 의도·금액 산정(원가격·원안분). 발행 claim-service. 구독 payment(명령은 동기; 이벤트는 기록), audit, notification(환불 결과 알림 연결). 토픽 order.claim.v1. 단계 ①. 2026-11-17: kind RETURN_FEE = 반품 회수비 돌려주기(회수비 결제 시도의 전액 취소 — 상품 환불 아님, basis 는 0)",
  "allOf": [
    {
      "$ref": "_envelope.v1.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "RefundIntentCreated"
        },
        "aggregateType": {
          "const": "Claim"
        },
        "payload": {
          "type": "object",
          "required": [
            "refundIntentId",
            "orderId",
            "amount",
            "paymentAttemptId"
          ],
          "properties": {
            "refundIntentId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "claimId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "orderId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "paymentAttemptId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "amount": {
              "$ref": "_defs.v1.json#/$defs/Money"
            },
            "kind": {
              "type": "string",
              "enum": [
                "ITEMS",
                "RETURN_FEE"
              ],
              "description": "2026-11-17 — ITEMS 상품 환불(원주문 결제의 취소), RETURN_FEE 반품 회수비 돌려주기(paymentAttemptId = 회수비 결제 시도, CL-1 추가 결정 2). 없으면 ITEMS"
            },
            "basis": {
              "type": "object",
              "required": [],
              "properties": {
                "itemAmount": {
                  "$ref": "_defs.v1.json#/$defs/Money"
                },
                "discountShare": {
                  "$ref": "_defs.v1.json#/$defs/Money"
                },
                "bagFee": {
                  "$ref": "_defs.v1.json#/$defs/Money"
                },
                "deliveryTip": {
                  "$ref": "_defs.v1.json#/$defs/Money"
                },
                "lines": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "orderLineId",
                      "qty",
                      "amount"
                    ],
                    "properties": {
                      "orderLineId": {
                        "$ref": "_defs.v1.json#/$defs/Ref"
                      },
                      "qty": {
                        "$ref": "_defs.v1.json#/$defs/PositiveQty"
                      },
                      "amount": {
                        "$ref": "_defs.v1.json#/$defs/Money"
                      }
                    },
                    "additionalProperties": true
                  }
                }
              },
              "additionalProperties": true,
              "description": "원가격·할인 안분 근거"
            },
            "createdAt": {
              "$ref": "_defs.v1.json#/$defs/DateTime"
            }
          },
          "additionalProperties": true
        }
      }
    }
  ]
}
