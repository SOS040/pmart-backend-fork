{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pmart.local/events/DockReservationResult.v1.json",
  "title": "DockReservationResult",
  "description": "도크 예약 요청의 결과. 발행 cdc-location. 구독 transport-planning. 토픽 cdc.location.v1",
  "allOf": [
    {
      "$ref": "_envelope.v1.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "DockReservationResult"
        },
        "aggregateType": {
          "const": "DockReservation"
        },
        "payload": {
          "type": "object",
          "required": [
            "reservationId",
            "dockId",
            "window",
            "result"
          ],
          "properties": {
            "reservationId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "requestId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "cdcId": {
              "$ref": "_defs.v1.json#/$defs/CenterId"
            },
            "dockId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "window": {
              "$ref": "_defs.v1.json#/$defs/TimeWindow"
            },
            "result": {
              "$ref": "_defs.v1.json#/$defs/ResultState"
            },
            "reason": {
              "type": "string"
            },
            "trfId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "tripId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            }
          },
          "additionalProperties": true
        }
      }
    }
  ]
}
