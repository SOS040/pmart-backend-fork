{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pmart.local/events/CustomerAuthenticated.v1.json",
  "title": "CustomerAuthenticated",
  "description": "소셜 인증 성공(이용 가능≠). 발행 auth. 구독 customer. 토픽 platform.auth.v1. 단계 ①",
  "allOf": [
    {
      "$ref": "_envelope.v1.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "CustomerAuthenticated"
        },
        "aggregateType": {
          "const": "Account"
        },
        "payload": {
          "type": "object",
          "required": [
            "accountId",
            "provider",
            "authenticatedAt"
          ],
          "properties": {
            "accountId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "provider": {
              "type": "string",
              "description": "소셜 제공자 코드"
            },
            "authenticatedAt": {
              "$ref": "_defs.v1.json#/$defs/DateTime"
            },
            "email": {
              "type": "string",
              "maxLength": 254,
              "description": "제공자가 준 이메일(ADR-0024). scope 에 따라 없을 수 있다. 개인정보 — 로그 금지"
            },
            "emailVerified": {
              "type": "boolean",
              "description": "제공자가 이메일을 확인했는지(Google email_verified)"
            },
            "name": {
              "type": "string",
              "description": "제공자 프로필 이름(실명만 — 구글 name·네이버 이름, 카카오는 동의항목 \"이름\"(kakao_account.name)이 있을 때만 — BR-111 2026-11-26, 없으면 비움. 닉네임으로 채우지 않는다)"
            },
            "providerNickname": {
              "type": "string",
              "maxLength": 100,
              "description": "(2026-11-25) 제공자 닉네임 — 카카오 닉네임·네이버 별명, 없으면 이름(구글은 이름). 고객이 앱에서 정한 별명과 다르다. 개인정보 — 로그 금지"
            },
            "pictureUrl": {
              "type": "string",
              "description": "제공자 프로필 사진 URL"
            }
          },
          "additionalProperties": true
        }
      }
    }
  ]
}
