{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pmart.local/events/EmployeeRegistered.v1.json",
  "title": "EmployeeRegistered",
  "description": "직원 등록·계정 발급 완료(사서함 → Keycloak 계정 → 비밀번호 설정 메일). employee-auth-service 가 Keycloak 사용자와 운영자 ID 를 연결하고 로그인 상태를 ACTIVE 로(근무 시작일 전에는 로그인 불가). 역할·권한 센터는 싣지 않는다(권한은 approval 승인 뒤 — ADR-0056 결정 4). 발행 hr-service(ADR-0056), 구독 employee-auth-service(직원 로그인 상태). 토픽 platform.employee.v1, 키 = 운영자 ID. 단계 ①",
  "allOf": [
    {
      "$ref": "_envelope.v1.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "EmployeeRegistered"
        },
        "aggregateType": {
          "const": "Employee"
        },
        "payload": {
          "type": "object",
          "required": [
            "operatorId",
            "employeeNo",
            "keycloakUserId",
            "mailAddress",
            "employmentType",
            "affiliation",
            "startDate"
          ],
          "properties": {
            "operatorId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "description": "운영자 ID(OP-…) = 직원 토큰 sub = aggregateId"
            },
            "employeeNo": {
              "type": "string",
              "pattern": "^P[0-9]{4}-[0-9]{5}$",
              "description": "사번(화면 표시용)"
            },
            "keycloakUserId": {
              "type": "string",
              "minLength": 1,
              "description": "Keycloak 사용자 ID(sub) — employee-auth-service 의 연결 키"
            },
            "mailAddress": {
              "type": "string",
              "minLength": 3
            },
            "employmentType": {
              "type": "string",
              "enum": [
                "REGULAR",
                "PART_TIME",
                "DAILY"
              ]
            },
            "affiliation": {
              "type": "object",
              "required": [
                "type",
                "code"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "HQ_DEPARTMENT",
                    "CENTER"
                  ]
                },
                "code": {
                  "type": "string"
                }
              }
            },
            "startDate": {
              "type": "string",
              "format": "date",
              "description": "근무 시작일(Asia/Seoul 날짜) — 이 날 전에는 로그인 불가"
            },
            "endDate": {
              "type": "string",
              "format": "date",
              "description": "계약 종료일 — 지나면 hr-service 가 EmployeeSuspended(CONTRACT_ENDED)"
            }
          },
          "additionalProperties": true
        }
      }
    }
  ]
}
