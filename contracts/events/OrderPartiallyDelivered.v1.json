{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pmart.local/events/OrderPartiallyDelivered.v1.json",
  "title": "OrderPartiallyDelivered",
  "description": "분할배송 일부 완료. 발행 order-service. 구독 notification, commerce. 토픽 order.order.v1. 단계 ①",
  "allOf": [
    {
      "$ref": "_envelope.v1.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "OrderPartiallyDelivered"
        },
        "aggregateType": {
          "const": "Order"
        },
        "payload": {
          "type": "object",
          "required": [
            "orderId",
            "deliveryId",
            "deliveredLines"
          ],
          "properties": {
            "orderId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "deliveryId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "shipmentId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "deliveredLines": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "orderLineId",
                  "qty"
                ],
                "properties": {
                  "orderLineId": {
                    "$ref": "_defs.v1.json#/$defs/Ref"
                  },
                  "qty": {
                    "$ref": "_defs.v1.json#/$defs/PositiveQty"
                  }
                },
                "additionalProperties": true
              },
              "minItems": 1
            },
            "deliveredAt": {
              "$ref": "_defs.v1.json#/$defs/DateTime"
            }
          },
          "additionalProperties": true
        }
      }
    }
  ]
}
