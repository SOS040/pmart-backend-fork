{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pmart.local/events/ReservationTimeChanged.v1.json",
  "title": "ReservationTimeChanged",
  "description": "예약배달 시간 변경 확정(S4, 2026-11-16 — OMS §4). 발행 order(orchestration S4 사가가 결과를 알린 때). 토픽 order.order.v1, 집계 Order. 구독 예정 notification(고객 안내)·BI — 2026-11-16 구독 전.",
  "allOf": [
    {
      "$ref": "_envelope.v1.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "ReservationTimeChanged"
        },
        "aggregateType": {
          "const": "Order"
        },
        "payload": {
          "type": "object",
          "required": [
            "orderId",
            "orderVersion",
            "requestId",
            "previousArrivalWindow",
            "arrivalWindow",
            "changedAt"
          ],
          "properties": {
            "orderId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "orderVersion": {
              "type": "integer",
              "minimum": 1
            },
            "requestId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "previousArrivalWindow": {
              "$ref": "#/$defs/Window"
            },
            "arrivalWindow": {
              "$ref": "#/$defs/Window"
            },
            "changedAt": {
              "$ref": "_defs.v1.json#/$defs/DateTime"
            }
          },
          "additionalProperties": true
        }
      }
    }
  ],
  "$defs": {
    "Window": {
      "type": "object",
      "required": [
        "date",
        "start",
        "end"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "start": {
          "type": "string"
        },
        "end": {
          "type": "string"
        }
      }
    }
  }
}
