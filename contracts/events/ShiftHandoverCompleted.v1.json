            },
            "fromOperatorId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "toOperatorId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "openCases": {
              "type": "array",
              "items": {
                "$ref": "_defs.v1.json#/$defs/Ref"
              }
            },
            "completedAt": {
              "$ref": "_defs.v1.json#/$defs/DateTime"
            }
          },
          "additionalProperties": true
        }
      }
    }
  ]
}
