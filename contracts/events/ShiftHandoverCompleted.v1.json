{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pmart.local/events/ShiftHandoverCompleted.v1.json",
  "title": "ShiftHandoverCompleted",
  "description": "교대. 발행 case. 구독 audit. 토픽 platform.case.v1. 단계 ②",
