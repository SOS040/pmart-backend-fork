{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pmart.local/events/RiderArrivedAtStore.v1.json",
  "title": "RiderArrivedAtStore",
  "description": "가게 도착(인계 아님). 발행 delivery-execution. 구독 mfc-fulfillment(QR 활성), delivery-tracking. 토픽 delivery.delivery.v1. 단계 ①",
  "allOf": [
    {
      "$ref": "_envelope.v1.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "RiderArrivedAtStore"
        },
        "aggregateType": {
          "const": "Delivery"
        },
        "payload": {
          "type": "object",
          "required": [
            "deliveryId",
            "riderId",
            "arrivedAt"
          ],
          "properties": {
            "deliveryId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "riderId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "mfcId": {
              "$ref": "_defs.v1.json#/$defs/CenterId"
            },
            "arrivedAt": {
              "$ref": "_defs.v1.json#/$defs/DateTime"
            }
          },
          "additionalProperties": true
        }
      }
    }
  ]
}
