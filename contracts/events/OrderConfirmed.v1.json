{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pmart.local/events/OrderConfirmed.v1.json",
  "title": "OrderConfirmed",
  "description": "PG 승인 대사 일치 + 재고/여력/슬롯 확정 후 주문이 확정된 사실. 발행 order-service. 구독 cart, mfc-fulfillment, notification, demand-planning, replenishment, delivery-dispatch, BI. 토픽 order.order.v1",
  "allOf": [
    { "$ref": "_envelope.v1.json" },
    {
      "type": "object",
      "properties": {
        "eventType": { "const": "OrderConfirmed" },
        "aggregateType": { "const": "Order" },
        "payload": {
          "type": "object",
          "required": ["orderId", "orderVersion", "accountId", "mfcId", "lines", "deliveryMode", "outOfStockPreference", "reservationId", "paymentAttemptId", "totalAmount"],
          "properties": {
            "orderId": { "$ref": "_defs.v1.json#/$defs/Ref" },
            "orderVersion": { "$ref": "_defs.v1.json#/$defs/Version" },
            "orderNumber": { "type": "string", "pattern": "^[1-9][0-9]{7}$", "description": "화면용 주문번호(숫자 8자리, 2026-11-16) — 포장 라벨·인계 화면에 보일 값. 이 필드 전 주문은 없음" },
            "accountId": { "$ref": "_defs.v1.json#/$defs/Ref" },
            "draftId": { "$ref": "_defs.v1.json#/$defs/Ref", "description": "주문으로 옮긴 주문 초안(2026-10-31 추가)" },
            "mfcId": { "$ref": "_defs.v1.json#/$defs/CenterId" },
            "lines": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["orderLineId", "sku", "qty", "unitsPerSku", "unitPrice", "discountShare"],
                "properties": {
                  "orderLineId": { "$ref": "_defs.v1.json#/$defs/Ref" },
                  "sku": { "$ref": "_defs.v1.json#/$defs/Sku" },
                  "qty": { "$ref": "_defs.v1.json#/$defs/PositiveQty" },
                  "unitsPerSku": { "type": "integer", "minimum": 1 },
                  "weightG": { "type": "integer", "minimum": 0, "description": "행 전체 중량(단위 중량 × qty)" },
                  "cartItemId": { "$ref": "_defs.v1.json#/$defs/Ref", "description": "주문 대상이던 장바구니 품목 — cart 가 주문분만 정리한다(2026-10-31 추가)" },
                  "productName": { "type": "string", "description": "주문 당시 상품명 사본(2026-11-07 추가, 단말 표시)" },
                  "unitPrice": { "$ref": "_defs.v1.json#/$defs/Money" },
                  "discountShare": { "$ref": "_defs.v1.json#/$defs/Money" },
                  "lotConstraint": { "type": "object", "properties": { "allowedLots": { "type": "array", "items": { "type": "string" } }, "minExpiryDate": { "$ref": "_defs.v1.json#/$defs/Date" } } }
                }
              }
            },
            "deliveryMode": { "$ref": "_defs.v1.json#/$defs/DeliveryMode" },
            "arrivalWindow": { "$ref": "_defs.v1.json#/$defs/TimeWindow" },
            "outOfStockPreference": { "$ref": "_defs.v1.json#/$defs/OutOfStockPreference" },
            "reservationId": { "$ref": "_defs.v1.json#/$defs/Ref" },
            "capacityHoldId": { "$ref": "_defs.v1.json#/$defs/Ref" },
            "slotHoldId": { "$ref": "_defs.v1.json#/$defs/Ref" },
            "paymentAttemptId": { "$ref": "_defs.v1.json#/$defs/Ref" },
            "itemAmount": { "$ref": "_defs.v1.json#/$defs/Money" },
            "deliveryTip": { "$ref": "_defs.v1.json#/$defs/Money" },
            "deliveryTipReason": { "type": "string", "enum": ["STANDARD", "OVER_30000", "FIRST_PURCHASE", "NONE"], "description": "배달팁 무료 사유(2026-10-31 추가)" },
            "bagFee": { "$ref": "_defs.v1.json#/$defs/Money" },
            "totalAmount": { "$ref": "_defs.v1.json#/$defs/Money" },
            "firstPurchase": { "type": "boolean", "description": "첫 구매 무료배달을 실제 적용한 주문(deliveryTipReason = FIRST_PURCHASE). customer 가 첫 구매 사용 기록을 남긴다" },
            "plannedShipments": { "type": "integer", "minimum": 1, "description": "계획 배송 수(10,000g 단위, 2026-10-31 추가 — 참고값). 실제 출고 단위는 shipments[]" },
            "shipments": {
              "type": "array",
              "description": "이행 계획(2026-11-07부터 채움). 슬라이스 6 D6-2: 주문당 출고 1개(shipmentId = <orderId>-S1, 모든 행). 10,000g 분할은 MFC Q-10 결정 뒤",
              "items": {
                "type": "object",
                "required": ["shipmentId", "lines"],
                "properties": {
                  "shipmentId": { "$ref": "_defs.v1.json#/$defs/Ref" },
                  "weightG": { "type": "integer" },
                  "lines": { "type": "array", "items": { "type": "object", "required": ["orderLineId", "qty"], "properties": { "orderLineId": { "type": "string" }, "qty": { "$ref": "_defs.v1.json#/$defs/PositiveQty" } } } }
                }
              }
            },
            "confirmedAt": { "$ref": "_defs.v1.json#/$defs/DateTime" }
          },
          "additionalProperties": true
        }
      }
    }
  ]
}
