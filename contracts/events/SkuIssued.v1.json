{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pmart.local/events/SkuIssued.v1.json",
  "title": "SkuIssued",
  "description": "본사 승인 후 SKU 발급. 발행 product-service. 구독 cdc-inventory, mfc-inventory, approval, pricing. 토픽 commerce.product.v1. 단계 ①",
  "allOf": [
    {
      "$ref": "_envelope.v1.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "SkuIssued"
        },
        "aggregateType": {
          "const": "Sku"
        },
        "payload": {
          "type": "object",
          "required": [
            "sku",
            "baseProductId",
            "version"
          ],
          "properties": {
            "sku": {
              "$ref": "_defs.v1.json#/$defs/Sku"
            },
            "baseProductId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "productId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "version": {
              "$ref": "_defs.v1.json#/$defs/Version"
            },
            "issuedAt": {
              "$ref": "_defs.v1.json#/$defs/DateTime"
            },
            "approvalRef": {
              "$ref": "_defs.v1.json#/$defs/ApprovalRef"
            }
          },
          "additionalProperties": true
        }
      }
    }
  ]
}
