{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pmart.local/events/LineShortageReported.v1.json",
  "title": "LineShortageReported",
  "description": "피킹 중 결품·파손·차단으로 라인 부족이 보고된 사실. 발행 mfc-fulfillment. 구독 order-orchestration, case(동의 없음 시), mfc-quality(파손). 토픽 mfc.fulfillment.v1 2026-11-16: 오배송 재발송(작업 지시 kind RESHIPMENT)이면 purpose MISDELIVERY_RESHIPMENT·caseId.",
  "allOf": [
    {
      "$ref": "_envelope.v1.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "LineShortageReported"
        },
        "aggregateType": {
          "const": "Fulfillment"
        },
        "payload": {
          "type": "object",
          "required": [
            "orderId",
            "orderLineId",
            "shortQty",
            "reason",
            "alreadyHandedOverQty"
          ],
          "properties": {
            "orderId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "fulfillmentId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "orderLineId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "sku": {
              "$ref": "_defs.v1.json#/$defs/Sku"
            },
            "lot": {
              "type": "string"
            },
            "shortQty": {
              "$ref": "_defs.v1.json#/$defs/PositiveQty"
            },
            "reason": {
              "type": "string",
              "enum": [
                "SHORT",
                "DAMAGED",
                "SPOILED",
                "BLOCKED",
                "PARTIAL_CLOSE"
              ],
              "description": "PARTIAL_CLOSE(2026-11-20, R-29 ADR-0077) = 센터 관리자 부분 종료로 끝낸 피킹 잔량 — 재고 결품이 아님(선반에 있음). 결품 사가가 같은 단계로 부분 취소·환불하고 예약은 집지 않은 양을 해제(mfc-inventory PARTIAL_CLOSE_CANCELLED). 품질 사고·결품률 지표 대상 아님. lot 없음"
            },
            "alreadyHandedOverQty": {
              "$ref": "_defs.v1.json#/$defs/Qty"
            },
            "reportedAt": {
              "$ref": "_defs.v1.json#/$defs/DateTime"
            },
            "purpose": {
              "type": "string",
              "enum": [
                "MISDELIVERY_RESHIPMENT"
              ],
              "description": "2026-11-16 — 오배송 재발송 작업 지시의 출고면 MISDELIVERY_RESHIPMENT(없으면 일반 주문 출고)"
            },
            "caseId": {
              "$ref": "_defs.v1.json#/$defs/Ref",
              "description": "오배송 재발송의 근거 사건(case)"
            }
          },
          "additionalProperties": true
        }
      }
    }
  ]
}
