{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pmart.local/events/ClaimClosed.v1.json",
  "title": "ClaimClosed",
  "description": "회수·검수·환불·통지 의무 모두 확인. 발행 claim-service. 구독 order, notification, case. 토픽 order.claim.v1. 단계 ②",
  "allOf": [
    {
      "$ref": "_envelope.v1.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "ClaimClosed"
        },
        "aggregateType": {
          "const": "Claim"
        },
        "payload": {
          "type": "object",
          "required": [
            "claimId",
            "outcome"
          ],
          "properties": {
            "claimId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "orderId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "outcome": {
              "type": "string",
              "description": "종결 결과 코드 — CANCELLED_REFUNDED(취소 환불 완료), REJECTED_HANDED_OVER(인계돼 취소 불가), 반품(2026-11-17 CL-1): RETURN_REFUNDED(모든 행 검수·환불 완료), RETURN_FEE_UNPAID(회수비 기한 안 미결제), RETURN_CANCELLED(상담원 취소)"
            },
            "closedAt": {
              "$ref": "_defs.v1.json#/$defs/DateTime"
            }
          },
          "additionalProperties": true
        }
      }
    }
  ]
}
