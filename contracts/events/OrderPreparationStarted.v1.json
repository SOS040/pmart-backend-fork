{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.pmart.local/events/OrderPreparationStarted.v1.json",
  "title": "OrderPreparationStarted",
  "description": "MFC PreparationStarted 반영. 이후 예약 시간 변경 차단. 발행 order-service. 구독 commerce(조회), notification. 토픽 order.order.v1. 단계 ①",
  "allOf": [
    {
      "$ref": "_envelope.v1.json"
    },
    {
      "type": "object",
      "properties": {
        "eventType": {
          "const": "OrderPreparationStarted"
        },
        "aggregateType": {
          "const": "Order"
        },
        "payload": {
          "type": "object",
          "required": [
            "orderId",
            "startedAt"
          ],
          "properties": {
            "orderId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "orderVersion": {
              "$ref": "_defs.v1.json#/$defs/Version"
            },
            "fulfillmentId": {
              "$ref": "_defs.v1.json#/$defs/Ref"
            },
            "startedAt": {
              "$ref": "_defs.v1.json#/$defs/DateTime"
            }
          },
          "additionalProperties": true
        }
      }
    }
  ]
}
