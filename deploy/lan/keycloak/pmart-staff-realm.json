{
  "realm": "pmart-staff",
  "loginTheme": "pmart",
  "enabled": true,
  "displayName": "PMart 직원",
  "smtpServer": {
    "host": "mailserver",
    "port": "25",
    "from": "no-reply@pmart.com",
    "fromDisplayName": "PMart",
    "ssl": "false",
    "starttls": "false",
    "auth": "false"
  },
  "sslRequired": "none",
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 43200,
  "ssoSessionMaxLifespan": 43200,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "waitIncrementSeconds": 600,
  "maxFailureWaitSeconds": 600,
  "maxDeltaTimeSeconds": 900,
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": true,
  "roles": {
    "realm": []
  },
  "clients": [
    {
      "clientId": "employee-auth-service",
      "name": "PMart 직원 로그인(employee-auth-service, ADR-0056) — 유일한 로그인 클라이언트",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "__PMART_KEYCLOAK_EMPLOYEE_AUTH_SECRET__",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://192.168.0.40:8443/api/v1/employee-auth/logins/callback"
      ],
      "webOrigins": [],
      "frontchannelLogout": false,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "backchannel.logout.url": "http://employee-auth-service:8511/api/v1/internal/keycloak-logouts",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "false",
        "post.logout.redirect.uris": "http://localhost:5173/login##http://localhost:5174/login##https://192.168.0.40/login##https://d603-16/login##https://192.168.0.40:8444/login##https://d603-16:8444/login##http://localhost:5175/login##https://192.168.0.40:8445/login##https://d603-16:8445/login##http://localhost:5176/login##https://192.168.0.40:8446/login##https://d603-16:8446/login##http://localhost:5177/login##https://192.168.0.40:8447/login##https://d603-16:8447/login"
      },
      "fullScopeAllowed": false,
      "protocolMappers": [
        {
          "name": "pmart_operator_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "pmart_operator_id",
            "claim.name": "pmart_operator_id",
            "jsonType.label": "String",
            "multivalued": "false",
            "access.token.claim": "false",
            "id.token.claim": "true",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "false"
          }
        }
      ],
      "defaultClientScopes": [
        "basic"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "pmart-dev-cli",
      "name": "LAN 시험 스크립트(직접 로그인) — LAN 전용, 운영 금지",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "pmart-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "pmart-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "pmart_operator_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "pmart_operator_id",
            "claim.name": "pmart_operator_id",
            "jsonType.label": "String",
            "multivalued": "false",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "hr-provisioner",
      "name": "hr-service Admin API (ADR-0056 결정 16 — 사용자 경로만)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "__PMART_KEYCLOAK_HR_PROVISIONER_SECRET__",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "fullScopeAllowed": false
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\": [{\"name\": \"username\", \"displayName\": \"${username}\", \"validations\": {\"length\": {\"min\": 3, \"max\": 255}, \"username-prohibited-characters\": {}, \"up-username-not-idn-homograph\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false}, {\"name\": \"email\", \"displayName\": \"${email}\", \"validations\": {\"email\": {}, \"length\": {\"max\": 255}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false}, {\"name\": \"firstName\", \"displayName\": \"${firstName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false}, {\"name\": \"lastName\", \"displayName\": \"${lastName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false}, {\"name\": \"pmart_operator_id\", \"displayName\": \"PMart 운영자 ID\", \"validations\": {\"pattern\": {\"pattern\": \"^[A-Za-z0-9_.-]{1,64}$\", \"error-message\": \"영문·숫자·_.- 1~64자\"}}, \"required\": {\"roles\": [\"admin\"]}, \"permissions\": {\"view\": [\"admin\"], \"edit\": [\"admin\"]}, \"multivalued\": false}], \"groups\": [{\"name\": \"user-metadata\", \"displayHeader\": \"User metadata\", \"displayDescription\": \"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  },
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "attributes": {
    "adminEventsExpiration": "604800"
  },
  "users": [
    {
      "username": "service-account-hr-provisioner",
      "enabled": true,
      "serviceAccountClientId": "hr-provisioner",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users"
        ]
      }
    }
  ],
  "clientScopeMappings": {
    "realm-management": [
      {
        "client": "hr-provisioner",
        "roles": [
          "manage-users",
          "view-users",
          "query-users"
        ]
      }
    ]
  }
}
