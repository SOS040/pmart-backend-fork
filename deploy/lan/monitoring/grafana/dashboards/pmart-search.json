    {
      "id": 11,
      "title": "요청 수(분당)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "pmart-prometheus"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "pmart-prometheus"
          },
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count{job=\"search-service\",uri=~\"/api/v1/search/.*\"}[5m])) * 60",
          "legendFormat": "{{uri}}"
