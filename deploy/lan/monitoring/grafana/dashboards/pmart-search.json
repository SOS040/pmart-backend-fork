    {
      "id": 12,
      "title": "응답 시간(평균·최대)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "pmart-prometheus"
      },
      "description": "히스토그램이 없어 백분위는 없다",
      "gridPos": {
        "x": 8,
