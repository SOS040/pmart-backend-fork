      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "pmart-prometheus"
          },
          "expr": "rate(pmart_logstash_events_out_total{pipeline=\"search-index\"}[15m]) * 60",
          "legendFormat": "내보낸 사건/분"
        },
        {
          "refId": "B",
          "datasource": {
