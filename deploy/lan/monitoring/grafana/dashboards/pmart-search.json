      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "pmart-prometheus"
          },
          "expr": "sum by (uri) (rate(http_server_requests_seconds_sum{job=\"search-service\",uri=~\"/api/v1/search/.*\"}[5m])) / sum by (uri) (rate(http_server_requests_seconds_count{job=\"search-service\",uri=~\"/api/v1/search/.*\"}[5m]))",
          "legendFormat": "평균 {{uri}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "pmart-prometheus"
          },
          "expr": "max by (uri) (http_server_requests_seconds_max{job=\"search-service\",uri=~\"/api/v1/search/.*\"})",
          "legendFormat": "최대 {{uri}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
