<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3"><hashTree><TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="pmart 비회원 부하(둘러보기·검색·장바구니·배송 조회)"><boolProp name="TestPlan.functional_mode">false</boolProp><boolProp name="TestPlan.serialize_threadgroups">false</boolProp><elementProp name="TestPlan.user_defined_variables" elementType="Arguments"><collectionProp name="Arguments.arguments"><elementProp name="host" elementType="Argument"><stringProp name="Argument.name">host</stringProp><stringProp name="Argument.value">${__P(host,192.168.0.40)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="port" elementType="Argument"><stringProp name="Argument.name">port</stringProp><stringProp name="Argument.value">${__P(port,8443)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="mfcId" elementType="Argument"><stringProp name="Argument.name">mfcId</stringProp><stringProp name="Argument.value">${__P(mfcId,MFC-BJG-01)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp></collectionProp></elementProp></TestPlan><hashTree><CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="검색어"><stringProp name="filename">${__P(keywords,keywords.csv)}</stringProp><stringProp name="fileEncoding">UTF-8</stringProp><stringProp name="variableNames">kw</stringProp><boolProp name="ignoreFirstLine">false</boolProp><stringProp name="delimiter">,</stringProp><boolProp name="quotedData">false</boolProp><boolProp name="recycle">true</boolProp><boolProp name="stopThread">false</boolProp><stringProp name="shareMode">shareMode.all</stringProp></CSVDataSet><hashTree/><ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="HTTP 기본값"><elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"/></elementProp><stringProp name="HTTPSampler.protocol">https</stringProp><stringProp name="HTTPSampler.domain">${host}</stringProp><stringProp name="HTTPSampler.port">${port}</stringProp><stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp><stringProp name="HTTPSampler.implementation">HttpClient4</stringProp><stringProp name="HTTPSampler.connect_timeout">5000</stringProp><stringProp name="HTTPSampler.response_timeout">15000</stringProp></ConfigTestElement><hashTree/><HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="공통 헤더"><collectionProp name="HeaderManager.headers"><elementProp name="" elementType="Header"><stringProp name="Header.name">Authorization</stringProp><stringProp name="Header.value">Bearer ${token}</stringProp></elementProp><elementProp name="" elementType="Header"><stringProp name="Header.name">X-Source-System</stringProp><stringProp name="Header.value">perf-jmeter</stringProp></elementProp><elementProp name="" elementType="Header"><stringProp name="Header.name">X-Device-Id</stringProp><stringProp name="Header.value">${device}</stringProp></elementProp><elementProp name="" elementType="Header"><stringProp name="Header.name">Content-Type</stringProp><stringProp name="Header.value">application/json</stringProp></elementProp><elementProp name="" elementType="Header"><stringProp name="Header.name">Accept</stringProp><stringProp name="Header.value">application/json</stringProp></elementProp></collectionProp></HeaderManager><hashTree/><ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="비회원 고객"><stringProp name="ThreadGroup.on_sample_error">continue</stringProp><elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController"><boolProp name="LoopController.continue_forever">false</boolProp><stringProp name="LoopController.loops">-1</stringProp></elementProp><stringProp name="ThreadGroup.num_threads">${__P(users,10)}</stringProp><stringProp name="ThreadGroup.ramp_time">${__P(ramp,60)}</stringProp><boolProp name="ThreadGroup.scheduler">true</boolProp><stringProp name="ThreadGroup.duration">${__P(duration,300)}</stringProp><stringProp name="ThreadGroup.delay">0</stringProp><boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp></ThreadGroup><hashTree><UniformRandomTimer guiclass="UniformRandomTimerGui" testclass="UniformRandomTimer" testname="생각 시간(기본 1~3초, -JthinkMin·-JthinkRange ms)"><stringProp name="ConstantTimer.delay">${__P(thinkMin,1000)}</stringProp><stringProp name="RandomTimer.range">${__P(thinkRange,2000)}</stringProp></UniformRandomTimer><hashTree/><JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="비회원 토큰 — 스레드마다 하나"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters">${__P(tokens,out/tokens.csv)}</stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">if (vars.get('token') == null) {
  def f = new File(Parameters)
  if (!f.isAbsolute()) { f = new File(org.apache.jmeter.services.FileServer.getFileServer().getBaseDir(), Parameters) }
  def lines = f.readLines('UTF-8').findAll { it.trim() }
  def p = lines[ctx.getThreadNum() % lines.size()].split(',')
  vars.put('device', p[0].trim()); vars.put('token', p[1].trim())
}</stringProp></JSR223PreProcessor><hashTree/><OnceOnlyController guiclass="OnceOnlyControllerGui" testclass="OnceOnlyController" testname="처음 한 번 — 상품 하나 잡기"/><hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="처음 검색"><elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"/></elementProp><stringProp name="HTTPSampler.path">/api/v1/search/products?q=${__urlencode(${kw})}&amp;mfcId=${mfcId}&amp;size=20</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.follow_redirects">false</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp></HTTPSamplerProxy><hashTree><JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="꺼내기"><stringProp name="JSONPostProcessor.referenceNames">pid;sku</stringProp><stringProp name="JSONPostProcessor.jsonPathExprs">$.items[*].productId;$.items[*].representativeSku</stringProp><stringProp name="JSONPostProcessor.match_numbers">0;0</stringProp><stringProp name="JSONPostProcessor.defaultValues">NONE;NONE</stringProp></JSONPostProcessor><hashTree/></hashTree></hashTree><ThroughputController guiclass="ThroughputControllerGui" testclass="ThroughputController" testname="둘러보기 40%"><intProp name="ThroughputController.style">1</intProp><boolProp name="ThroughputController.perThread">false</boolProp><intProp name="ThroughputController.maxThroughput">1</intProp><FloatProperty><name>ThroughputController.percentThroughput</name><value>40.0</value><savedValue>0.0</savedValue></FloatProperty></ThroughputController><hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="홈 /storefront/home"><elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"/></elementProp><stringProp name="HTTPSampler.path">/api/v1/storefront/home?mfcId=${mfcId}</stringProp><stringProp name="HTTPSampler.method">GE