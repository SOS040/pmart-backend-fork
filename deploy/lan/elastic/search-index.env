# 검색 색인 파이프라인(Logstash search-index.conf)이 쓸 색인·소비 그룹. render.sh 가 logstash 환경변수로 넣는다.
# 평소: 별칭(products·sku-prices·sku-handlings·sku-discounts)에 쓴다. 재색인 중에만 새 색인·새 소비 그룹으로 바꾼다 — 절차 deploy/lan/elastic/REINDEX.md
PMART_SEARCH_PRODUCTS_INDEX=products
PMART_SEARCH_PRICES_INDEX=sku-prices
PMART_SEARCH_HANDLINGS_INDEX=sku-handlings
PMART_SEARCH_GROUP_ID=search-index-logstash-v11
PMART_SEARCH_DLT_TOPIC=search-index.DLT
PMART_SEARCH_DISCOUNTS_INDEX=sku-discounts
